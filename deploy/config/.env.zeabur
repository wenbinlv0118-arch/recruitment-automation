# ===========================================
# Zeabur 部署环境变量配置模板
# ===========================================
# 复制此文件内容到 Zeabur Variables 页面

# ========== 后端服务环境变量 ==========

# 基础配置
NODE_ENV=production
PORT=3001

# 数据库配置 (Supabase)
SUPABASE_URL=https://fftjmohzkzkkqzqgaqfe.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZmdGptb2h6a3pra3F6cWdhcWZlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTczMDI1NjYsImV4cCI6MjA3Mjg3ODU2Nn0._PQEDYFp0XTL8sHatcVCMl6pcjooLo79CASTaulFbdQ
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZmdGptb2h6a3pra3F6cWdhcWZlIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc1NzMwMjU2NiwiZXhwIjoyMDcyODc4NTY2fQ.ZhVVUag5S1q2fCSEQ2q_H_z5hV5gXrOdSJ1Q2k3fYTk

# JWT 配置
# 生成命令: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random_at_least_64_characters

# CORS 配置
# 第一阶段：临时允许所有来源（部署后端时使用）
CORS_ORIGIN=*
# 第二阶段：前端部署后更新为具体域名
# CORS_ORIGIN=https://recruitment-frontend-xxx.zeabur.app

# 可选配置
UPLOAD_MAX_SIZE=10485760
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# 浏览器配置（生产环境）
BROWSER_HEADLESS=true
DISPLAY=:99
XVFB_WHD=1920x1080x24

# D-Bus 完全禁用配置（修复colon错误和系统总线错误）
DBUS_SESSION_BUS_ADDRESS=""
DBUS_SYSTEM_BUS_ADDRESS=""
NO_DBUS=1
DISABLE_DBUS=1

# 禁用其他可能触发D-Bus的服务
NO_AT_BRIDGE=1
GSETTINGS_BACKEND=memory
GDK_BACKEND=x11

# 额外的D-Bus禁用变量
DBUS_FATAL_WARNINGS=0
DBUS_VERBOSE=0

# 彻底禁用系统集成和D-Bus相关服务
XDG_RUNTIME_DIR="/tmp"
PULSE_RUNTIME_PATH="/tmp"
DBUS_STARTER_BUS_TYPE=""
DBUS_SESSION_BUS_PID=""
DBUS_SYSTEM_BUS_PID=""

# 禁用桌面集成功能
DISABLE_DESKTOP_NOTIFICATIONS=1
DISABLE_SYSTEM_NOTIFICATIONS=1

# Zeabur特定D-Bus禁用配置
ZEABUR_DISABLE_DBUS=1
CONTAINER_DISABLE_DBUS=1

# ========== 前端服务环境变量 ==========
# 注意：前端环境变量需要在 frontend/.env.production 文件中配置
# 然后推送到 GitHub，Zeabur 会自动读取

# 前端 API 配置（在 frontend/.env.production 中设置）
# REACT_APP_API_URL=https://recruitment-backend-xxx.zeabur.app
# REACT_APP_SUPABASE_URL=https://fftjmohzkzkkqzqgaqfe.supabase.co
# REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZmdGptb2h6a3pra3F6cWdhcWZlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTczMDI1NjYsImV4cCI6MjA3Mjg3ODU2Nn0._PQEDYFp0XTL8sHatcVCMl6pcjooLo79CASTaulFbdQ

# ========== Zeabur 特定配置 ==========

# 静态网站配置（前端服务使用）
ZBPACK_STATIC_DIR=build

# 构建配置（如果需要自定义）
# ZBPACK_BUILD_COMMAND=npm install && npm run build
# ZBPACK_START_COMMAND=npm start

# 应用目录配置（Monorepo 项目）
# 后端服务: ZBPACK_APP_DIR=backend
# 前端服务: ZBPACK_APP_DIR=frontend

# ========== 部署步骤提醒 ==========
# 1. 先部署后端服务，使用上述后端环境变量
# 2. 获取后端 URL 后，更新前端配置文件
# 3. 部署前端服务
# 4. 更新后端的 CORS_ORIGIN 为前端 URL
# 5. 测试完整功能

# ========== 安全注意事项 ==========
# - JWT_SECRET 必须是强随机字符串
# - 生产环境不要使用 CORS_ORIGIN=*
# - 定期轮换敏感密钥
# - 监控访问日志