{
  "version": 2,
  "name": "recruitment-automation",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/.netlify/functions/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/build/$1"
    }
  ],
  "env": {
    "REACT_APP_API_URL": "https://recruitment-automation.netlify.app/.netlify/functions",
    "REACT_APP_WS_URL": "wss://recruitment-automation.netlify.app/.netlify/functions/socket"
  },
  "functions": {
    "frontend/src/setupProxy.js": {
      "includeFiles": "frontend/build/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/.netlify/functions/$1"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/frontend/build/index.html"
    }
  ]
}