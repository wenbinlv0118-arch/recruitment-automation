# 生产环境环境变量配置
# 自动生成于 2025/9/8 17:51:40

# 应用配置
REACT_APP_NAME=智能招聘自动化系统
REACT_APP_VERSION=1.0.0
REACT_APP_ENV=production

# API 配置
REACT_APP_API_BASE_URL=https://your-functions.netlify.app/.netlify/functions
REACT_APP_SOCKET_URL=wss://your-functions.netlify.app

# Supabase 配置
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# 功能开关
REACT_APP_ENABLE_DEBUG=false
REACT_APP_ENABLE_MOCK_DATA=false
REACT_APP_ENABLE_ANALYTICS=true

# 第三方服务
REACT_APP_SENTRY_DSN=
REACT_APP_GOOGLE_ANALYTICS_ID=

# 文件上传配置
REACT_APP_MAX_FILE_SIZE=10485760
REACT_APP_ALLOWED_FILE_TYPES=.pdf,.docx,.txt

# UI 配置
REACT_APP_THEME=light
REACT_APP_LANGUAGE=zh-CN
REACT_APP_TIMEZONE=Asia/Shanghai

# 性能配置
REACT_APP_ENABLE_SERVICE_WORKER=true
REACT_APP_CACHE_DURATION=3600000

# 安全配置
REACT_APP_ENABLE_CSP=true
REACT_APP_ALLOWED_ORIGINS=https://your-app.vercel.app
