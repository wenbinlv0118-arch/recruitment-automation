{
  "build_command": "echo 'Monorepo detected, please specify service'",
  "services": {
    "backend": {
      "dockerfile": "backend/Dockerfile",
      "context": "backend",
      "environment": "docker",
      "framework": "express",
      "node_version": "20",
      "env": {
        "BROWSER_HEADLESS": "true",
        "DISPLAY": ":99",
        "XVFB_WHD": "1920x1080x24",
        "NODE_ENV": "production",
        "ZEABUR": "true",
        "CONTAINER": "true",
        "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright",
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "0"
      },
      "resources": {
        "memory": "1Gi",
        "cpu": "0.5"
      }
    },
    "frontend": {
      "build_command": "cd frontend && npm ci && npm run build",
      "output_dir": "frontend/build",
      "install_command": "cd frontend && npm ci",
      "node_version": "20",
      "cache_dependencies": true,
      "environment": "static",
      "framework": "react",
      "spa": true,
      "env": {
        "NODE_ENV": "production",
        "REACT_APP_NODE_ENV": "production"
      }
    },
    "vnc-browser": {
      "dockerfile": "vnc-service/Dockerfile",
      "context": "vnc-service",
      "environment": "docker",
      "ports": {
        "6080": "HTTP",
        "5900": "TCP"
      },
      "env": {
        "VNC_RESOLUTION": "1280x720",
        "VNC_PASSWORD": "vnc123",
        "VNC_PORT": "5900",
        "NO_VNC_PORT": "6080",
        "DISPLAY": ":1",
        "NODE_ENV": "production",
        "ZEABUR": "true",
        "CONTAINER": "true"
      },
      "resources": {
        "memory": "2Gi",
        "cpu": "1"
      },
      "volumes": ["/data"]
    }
  },
  "meta": {
    "name": "Recruitment Automation",
    "description": "智能招聘自动化平台 - 支持VNC远程桌面监控 - Zeabur 部署配置 v2.0",
    "version": "2.0.0",
    "author": "Recruitment Team",
    "repository": "https://github.com/wenbinlv0118-arch/recruitment-automation",
    "keywords": ["recruitment", "automation", "vnc", "browser", "zeabur"],
    "deployment": {
      "platform": "zeabur",
      "optimized_for": "container",
      "supports_vnc": true,
      "browser_automation": true
    }
  }
}