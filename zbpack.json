{
  "build_command": "echo 'Monorepo: Please select specific service to deploy'",
  "services": {
    "backend": {
      "root_dir": "backend",
      "environment": "docker",
      "framework": "express",
      "node_version": "20",
      "install_command": "PUPPETEER_SKIP_DOWNLOAD=true PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true npm ci",
      "build_command": "npm run build",
      "env": {
        "BROWSER_HEADLESS": "true",
        "NODE_ENV": "production",
        "ZEABUR": "true",
        "CONTAINER": "true",
        "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright",
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "0",
        "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS": "true",
        "npm_config_ignore_scripts": "true",
        "PUPPETEER_SKIP_DOWNLOAD": "true",
        "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD": "true",
        "VNC_SERVICE_URL": "https://recruitment-automation-vnc-browser.zeabur.app",
        "FRONTEND_URL": "https://recruitment-automation-frontend.zeabur.app",
        "BACKEND_URL": "https://recruitment-automation-backend.zeabur.app"
      },
      "resources": {
        "memory": "2Gi",
        "cpu": "1"
      }
    },
    "frontend": {
      "root_dir": "frontend",
      "build_command": "npm install && npm run build",
      "output_dir": "build",
      "install_command": "npm install",
      "node_version": "20",
      "cache_dependencies": true,
      "environment": "static",
      "framework": "react",
      "spa": true,
      "env": {
        "NODE_ENV": "production",
        "REACT_APP_NODE_ENV": "production"
      }
    },
    "vnc-browser": {
      "root_dir": "vnc-service",
      "environment": "docker",
      "ports": {
        "6080": "HTTP",
        "5900": "TCP"
      },
      "env": {
        "VNC_RESOLUTION": "1280x720",
        "VNC_PASSWORD": "vnc123",
        "VNC_PORT": "5900",
        "NO_VNC_PORT": "6080",
        "DISPLAY": ":1",
        "NODE_ENV": "production",
        "ZEABUR": "true",
        "CONTAINER": "true"
      },
      "resources": {
        "memory": "2Gi",
        "cpu": "1"
      },
      "volumes": ["/data"]
    }
  },
  "meta": {
    "name": "Recruitment Automation",
    "description": "智能招聘自动化平台 - 支持VNC远程桌面监控 - Zeabur Monorepo 部署配置 v3.0",
    "version": "3.0.0",
    "author": "Recruitment Team",
    "repository": "https://github.com/wenbinlv0118-arch/recruitment-automation",
    "keywords": ["recruitment", "automation", "vnc", "browser", "zeabur", "monorepo"],
    "deployment": {
      "platform": "zeabur",
      "architecture": "monorepo",
      "optimized_for": "container",
      "supports_vnc": true,
      "browser_automation": true,
      "services": ["backend", "frontend", "vnc-browser"]
    }
  }
}