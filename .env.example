# 应用配置
NODE_ENV=development
PORT=5001

# 大语言模型API配置
LLM_API_KEY=your_llm_api_key
LLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
LLM_MODEL=glm-4-flash

# Hugging Face API配置（用于文本向量化）
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Supabase 配置
# 从 Supabase Dashboard > Settings > API 获取这些值
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 数据库配置（生产环境使用 Supabase，开发环境可选择 SQLite）
DATABASE_TYPE=supabase
# DATABASE_TYPE=sqlite  # 开发环境可选择 SQLite

# SQLite 配置（仅在 DATABASE_TYPE=sqlite 时使用）
SQLITE_DB_PATH=./storage/knowledge.db

# 文件存储配置
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE=50MB

# 招聘平台配置
# Boss直聘
BOSS_ZHIPIN_ENABLED=true
BOSS_ZHIPIN_AUTO_LOGIN=false

# 智联招聘
ZHILIAN_ENABLED=true
ZHILIAN_AUTO_LOGIN=false

# 前程无忧
QCWY_ENABLED=false

# 安全配置
JWT_SECRET=your-jwt-secret-key
SESSION_SECRET=your-session-secret

# CORS 配置
CORS_ORIGIN=http://localhost:3000

# 日志配置
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# 缓存配置
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# 邮件配置（可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# 第三方服务配置
# OpenAI API（可选）
OPENAI_API_KEY=your-openai-api-key

# 百度AI API（可选）
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key

# 腾讯云API（可选）
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key

# 阿里云API（可选）
ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret

# 监控和分析
SENTRY_DSN=your-sentry-dsn
GOOGLE_ANALYTICS_ID=your-ga-id

# 部署配置
VERCEL_URL=your-vercel-url
NETLIFY_URL=your-netlify-url