# Boss直聘智能寻聘系统环境变量配置
# 基础配置
NODE_ENV=development
DEBUG=false
HOST=localhost
PORT=5001

# 数据库配置
MONGODB_URI=mongodb://localhost:27017/boss_zhipin_recruitment
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=false

# 安全配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=your-32-character-encryption-key

# 邮件配置
EMAIL_ENABLED=false
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password
EMAIL_FROM=your-email@gmail.com

# 浏览器自动化配置
HEADLESS=true
SLOW_MO=0
BROWSER_TIMEOUT=30000

# CORS配置
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# 日志配置
LOG_LEVEL=info

# Boss直聘账号配置
BOSS_ZHIPIN_USERNAME=your-phone-number
BOSS_ZHIPIN_PASSWORD=your-password

# 大语言模型配置（可选）
LLM_API_KEY=d4820908e52b4302a6c0135ec28bb8d9.YH0DoJ2y3mqH3yra
LLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions 
LLM_MODEL=glm-4.5

# 系统配置
APP_NAME=Boss直聘智能寻聘系统
APP_VERSION=1.0.0
APP_ENV=development

# 文件存储配置
STORAGE_BASE_DIR=./storage
RESUME_MAX_SIZE=10485760
LOG_RETENTION_DAYS=30

# 任务调度配置
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai

# 缓存配置
CACHE_LOCAL_ENABLED=true
CACHE_REDIS_ENABLED=false
CACHE_DEFAULT_TTL=3600

# 质量检测配置
QUALITY_ENABLED=true
QUALITY_MIN_RESPONSE_RATE=0.3
QUALITY_MIN_MATCH_SCORE=0.7
QUALITY_MIN_CONVERSION_RATE=0.1

# 数据分析配置
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=365

# API配置
API_VERSION=v1
API_PREFIX=/api
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_MAX=1000

# 通知配置
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SYSTEM_ENABLED=true
NOTIFICATION_MAX_NOTIFICATIONS=100
NOTIFICATION_RETENTION_DAYS=30

# WebSocket配置
WEBSOCKET_ENABLED=true
WEBSOCKET_PING_TIMEOUT=60000
WEBSOCKET_PING_INTERVAL=25000

# 安全限制配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BCRYPT_SALT_ROUNDS=12

# 性能配置
MAX_REQUEST_SIZE=52428800
MAX_FILE_SIZE=10485760
MAX_HTTP_BUFFER_SIZE=100000000

# 监控配置
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=1800000
PERFORMANCE_MONITORING_ENABLED=true

# 备份配置
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * 0
BACKUP_RETENTION_DAYS=180

# 开发配置（仅在开发环境使用）
DEV_AUTO_RELOAD=false
DEV_MOCK_DATA=false
DEV_VERBOSE_LOGGING=false

# 生产配置（仅在生产环境使用）
PROD_SSL_ENABLED=false
PROD_SSL_CERT_PATH=
PROD_SSL_KEY_PATH=
PROD_COMPRESSION_ENABLED=true
PROD_TRUST_PROXY=false

# 测试配置（仅在测试环境使用）
TEST_DATABASE_URI=mongodb://localhost:27017/boss_zhipin_recruitment_test
TEST_LOG_LEVEL=error
TEST_HEADLESS=true

# 第三方服务配置
SENTRY_DSN=
GOOGLE_ANALYTICS_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# 特殊功能开关
FEATURE_AI_SUGGESTION=true
FEATURE_AUTO_REPLY=false
FEATURE_VOICE_CALL=false
FEATURE_VIDEO_INTERVIEW=false
FEATURE_RESUME_PARSER=true
FEATURE_CANDIDATE_SCORING=true
FEATURE_QUALITY_CHECK=true
FEATURE_DATA_EXPORT=true
FEATURE_REAL_TIME_NOTIFICATION=true
FEATURE_MULTI_TENANT=false

# 企业配置
COMPANY_NAME=
COMPANY_INDUSTRY=
COMPANY_SIZE=
COMPANY_LOCATION=
COMPANY_DESCRIPTION=

# 招聘配置
RECRUITMENT_MAX_CANDIDATES_PER_DAY=50
RECRUITMENT_MAX_MESSAGES_PER_DAY=100
RECRUITMENT_AUTO_REPLY_ENABLED=false
RECRUITMENT_QUALITY_THRESHOLD=0.7

# 数据隐私配置
DATA_RETENTION_DAYS=365
DATA_ANONYMIZATION_ENABLED=false
DATA_EXPORT_ENABLED=true
DATA_DELETE_ENABLED=true

# 系统维护配置
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=系统正在维护中，请稍后再试
MAINTENANCE_START_TIME=
MAINTENANCE_END_TIME=