# 🔧 智能招聘系统 - 环境变量配置模板
# 复制此文件为 .env.production 并填入实际值

# ===========================================
# 数据库配置 (Supabase)
# ===========================================
# 在 https://supabase.com 项目设置中获取
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key

# ===========================================
# 应用配置
# ===========================================
# 后端API地址 (Koyeb部署后的URL)
REACT_APP_API_URL=https://your-app-name.koyeb.app

# 前端地址 (腾讯云EdgeOne Pages或自定义域名)
REACT_APP_FRONTEND_URL=https://your-domain.eu.org

# API基础路径
REACT_APP_API_BASE_PATH=/api

# ===========================================
# 安全配置
# ===========================================
# JWT密钥 (请生成一个强密码)
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# JWT过期时间
JWT_EXPIRES_IN=7d

# ===========================================
# 服务器配置
# ===========================================
# 服务器端口
PORT=3001

# 运行环境
NODE_ENV=production

# CORS允许的源
CORS_ORIGIN=https://your-domain.eu.org

# ===========================================
# 文件上传配置
# ===========================================
# 最大文件大小 (MB)
MAX_FILE_SIZE=10

# 允许的文件类型
ALLOWED_FILE_TYPES=pdf,doc,docx

# ===========================================
# 邮件配置 (可选)
# ===========================================
# SMTP服务器配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ===========================================
# 日志配置
# ===========================================
# 日志级别
LOG_LEVEL=info

# ===========================================
# 缓存配置
# ===========================================
# Redis URL (可选，用于缓存)
# REDIS_URL=redis://localhost:6379

# ===========================================
# 监控配置
# ===========================================
# 应用名称
APP_NAME=智能招聘系统

# 应用版本
APP_VERSION=1.0.0