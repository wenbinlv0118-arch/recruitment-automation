# Boss直聘智能寻聘系统 - 生产环境配置模板
# 请复制此文件为 .env.production 并填入真实的生产环境配置

# ==================== 基础配置 ====================
NODE_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=5001

# ==================== 数据库配置 ====================
# MongoDB 配置
MONGODB_URI=mongodb://localhost:27017/boss_zhipin_recruitment_prod
MONGODB_OPTIONS={"useNewUrlParser":true,"useUnifiedTopology":true}

# Redis 配置（推荐在生产环境启用）
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_CONNECTION_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=3000

# ==================== 安全配置 ====================
# JWT 配置（必须更改为强密钥）
JWT_SECRET=your-super-strong-jwt-secret-key-at-least-32-characters
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# 加密配置（必须更改为32位密钥）
ENCRYPTION_KEY=your-32-character-encryption-key-here

# API 安全配置
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=100

# CORS 配置（仅允许信任的域名）
CORS_ORIGIN=https://your-production-domain.com
CORS_CREDENTIALS=true

# ==================== 邮件配置 ====================
EMAIL_ENABLED=true
EMAIL_SERVICE=gmail
EMAIL_USER=your-production-email@company.com
EMAIL_PASS=your-email-app-password
EMAIL_FROM=noreply@company.com

# ==================== 浏览器自动化配置 ====================
# 生产环境建议使用无头模式
HEADLESS=true
SLOW_MO=0
BROWSER_TIMEOUT=60000
BROWSER_MAX_INSTANCES=3
BROWSER_MEMORY_LIMIT=2048

# 反爬虫配置
USE_PROXY=false
PROXY_LIST=
USER_AGENT_ROTATION=true
REQUEST_DELAY_MIN=1000
REQUEST_DELAY_MAX=3000

# ==================== 日志配置 ====================
LOG_LEVEL=warn
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/var/log/boss-zhipin/app.log
LOG_MAX_SIZE=100m
LOG_MAX_FILES=10
LOG_COMPRESS=true

# 结构化日志配置
LOG_FORMAT=json
LOG_TIMESTAMP=true
LOG_CORRELATION_ID=true

# ==================== Boss直聘账号配置 ====================
# 注意：生产环境不建议在配置文件中存储密码
# 建议使用环境变量或密钥管理服务
BOSS_ZHIPIN_USERNAME=
BOSS_ZHIPIN_PASSWORD=

# ==================== 大语言模型配置 ====================
LLM_ENABLED=true
LLM_API_KEY=your-production-llm-api-key
LLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
LLM_MODEL=glm-4.5
LLM_TIMEOUT=30000
LLM_MAX_RETRIES=3

# ==================== 监控配置 ====================
# 健康检查配置
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# 性能监控配置
PERFORMANCE_MONITORING_ENABLED=true
METRICS_COLLECTION_INTERVAL=60000

# 错误报告配置
ERROR_REPORTING_ENABLED=true
ERROR_REPORTING_SERVICE=sentry
SENTRY_DSN=your-sentry-dsn

# ==================== 存储配置 ====================
# 文件存储配置
FILE_STORAGE_TYPE=local
FILE_STORAGE_PATH=/var/data/boss-zhipin/storage
FILE_MAX_SIZE=50MB
FILE_ALLOWED_TYPES=pdf,doc,docx,txt

# 备份配置
BACKUP_ENABLED=true
BACKUP_INTERVAL=daily
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/var/backups/boss-zhipin

# ==================== 缓存配置 ====================
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ==================== 队列配置 ====================
QUEUE_ENABLED=true
QUEUE_REDIS_DB=1
QUEUE_CONCURRENCY=5
QUEUE_MAX_ATTEMPTS=3

# ==================== 系统配置 ====================
APP_NAME=Boss直聘智能寻聘系统
APP_VERSION=1.0.0
APP_ENVIRONMENT=production

# 系统资源限制
MAX_MEMORY_USAGE=2048
MAX_CPU_USAGE=80
MAX_CONCURRENT_JOBS=10

# ==================== 安全增强配置 ====================
# 请求体大小限制
REQUEST_SIZE_LIMIT=10mb

# 会话配置
SESSION_SECRET=your-session-secret-key
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# 内容安全策略
CSP_ENABLED=true
CSP_DIRECTIVES="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"

# ==================== 部署配置 ====================
# 集群配置
CLUSTER_ENABLED=false
CLUSTER_WORKERS=auto

# 优雅关闭配置
GRACEFUL_SHUTDOWN_TIMEOUT=30000

# ==================== 注意事项 ====================
# 1. 所有密钥和密码必须更改为强随机值
# 2. 生产环境建议使用密钥管理服务（如 AWS Secrets Manager）
# 3. 定期轮换密钥和证书
# 4. 启用所有安全相关配置
# 5. 配置适当的监控和告警
# 6. 定期备份数据和配置
# 7. 使用 HTTPS 和其他安全传输协议
# 8. 限制网络访问和防火墙规则
# 9. 定期更新依赖包和安全补丁
# 10. 进行安全审计和渗透测试