SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZmdGptb2h6a3pra3F6cWdhcWZlIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc1NzMwMjU2NiwiZXhwIjoyMDcyODc4NTY2fQ.ZhVVUag5S1q2fCSEQ2q_H_z5hV5gXrOdSJ1Q2k3fYTk
JWT_SECRET=6d270b06543073a8bd6f648fc92a404d3a1ff85f17e9570f736a6dc9fd10561c6d6c40b9f29bffbdd331016af92d9d65482c17bc3bfe27e2c3198e74521ad13b
CORS_ORIGIN=*

# 浏览器配置
BROWSER_HEADLESS=true
# 完全禁用显示服务器（修复Missing X server or $DISPLAY错误）
# DISPLAY=:99  # 注释掉，避免X11查找
# XVFB_WHD=1920x1080x24  # 注释掉，避免Xvfb依赖
DISPLAY=""
XAUTHORITY=""
XDG_SESSION_TYPE=""
WAYLAND_DISPLAY=""

# 修复colon错误和系统总线错误 - 彻底禁用D-Bus系统集成
DBUS_SESSION_BUS_ADDRESS=""
DBUS_SYSTEM_BUS_ADDRESS=""
NO_DBUS=1
DISABLE_DBUS=1
DISABLE_SYSTEM_DBUS=1
DISABLE_DESKTOP_NOTIFICATIONS=1
DISABLE_SYSTEM_NOTIFICATIONS=1
DISABLE_SYSTEM_INTEGRATION=1
DISABLE_ACCESSIBILITY=1
DISABLE_CRASH_REPORTER=1
DISABLE_BREAKPAD=1

# 强化D-Bus系统总线禁用（针对/run/dbus/system_bus_socket错误）
DBUS_STARTER_BUS_TYPE=""
DBUS_STARTER_ADDRESS=""
DBUS_SESSION_BUS_PID=""
DBUS_SESSION_BUS_WINDOWID=""
NO_AT_BRIDGE=1
GTK_MODULES=""
QT_ACCESSIBILITY=0
QT_QPA_PLATFORM=offscreen
XDG_CURRENT_DESKTOP=""
DESKTOP_SESSION=""
GNOME_DESKTOP_SESSION_ID=""
KDE_SESSION_VERSION=""
UNITY_DEFAULT_PROFILE=""
CHROME_DESKTOP=""
CHROME_VERSION_EXTRA=""
DISABLE_SYSTEM_PROXY_CONFIG_SERVICE=1
DISABLE_SYSTEM_FONT_FALLBACK=1
DISABLE_SYSTEM_NOTIFICATION_SERVICE=1

# 禁用其他可能触发D-Bus的服务
GSETTINGS_BACKEND=memory
GDK_BACKEND=x11

# 额外的D-Bus禁用变量
DBUS_FATAL_WARNINGS=0
DBUS_VERBOSE=0

# 彻底禁用系统集成和D-Bus相关服务
XDG_RUNTIME_DIR="/tmp"
PULSE_RUNTIME_PATH="/tmp"
DBUS_SYSTEM_BUS_PID=""

# 强化容器环境变量（修复浏览器启动失败Code: 1）
HOME="/tmp"
TMPDIR="/tmp"
TEMP="/tmp"
TMP="/tmp"
USER="nobody"
LOGNAME="nobody"
SHELL="/bin/sh"
PATH="/usr/local/bin:/usr/bin:/bin"

# 禁用所有可能的系统集成服务
GNOME_ACCESSIBILITY="0"
QT_ACCESSIBILITY="0"
AT_SPI_BUS_ADDRESS=""
AT_SPI_IOR=""
ORBIT_SOCKETDIR=""
SESSION_MANAGER=""
GDM_LANG=""
LANG="C"
LC_ALL="C"
LANGUAGE=""

# 禁用音频和媒体服务
PULSE_SERVER=""
ALSA_CARD=""
ALSA_DEVICE=""
JACK_DEFAULT_SERVER=""
SDL_AUDIODRIVER="dummy"

# 禁用网络发现和系统服务
AVAHI_COMPAT_NOWARN="1"
MDNS_MINIMAL="1"
NO_PROXY="*"
HTTP_PROXY=""
HTTPS_PROXY=""
FTP_PROXY=""

# 禁用字体和主题服务
FONTCONFIG_PATH="/dev/null"
GTK_THEME=""
GTK2_RC_FILES=""
GTK_RC_FILES=""
QT_STYLE_OVERRIDE=""
KDE_SESSION_VERSION=""
KDE_FULL_SESSION=""

# 禁用输入法和键盘服务
XMODIFIERS=""
GTK_IM_MODULE=""
QT_IM_MODULE=""
XIM=""
XIM_PROGRAM=""
INPUT_METHOD=""

# 在文件末尾添加缺失的关键变量
DISABLE_DEV_SHM_USAGE=1
NO_SANDBOX=1
DISABLE_GPU=1
DISABLE_SETUID_SANDBOX=1

# VNC服务配置（生产环境）
VNC_SERVER_URL=https://recruitment-automation-vnc.zeabur.app
VNC_DISPLAY=:1
VNC_PORT=5901
VNC_PASSWORD=vnc123
