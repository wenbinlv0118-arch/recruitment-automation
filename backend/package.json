{
  "name": "recruitment-backend",
  "version": "1.0.0",
  "description": "招聘自动化后端服务",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "start:prod": "NODE_ENV=production node src/index.js",
    "start:zeabur": "NODE_ENV=production ZEABUR_ENVIRONMENT=true node src/index.js",
    "start:headless": "HEADLESS_MODE=true node src/index.js",
    "test:env": "node scripts/test-env-config.js",
    "test:env:prod": "NODE_ENV=production node scripts/test-env-config.js",
    "test:env:zeabur": "NODE_ENV=production ZEABUR_ENVIRONMENT=true node scripts/test-env-config.js",
    "start:optimized": "node --expose-gc --max-old-space-size=2048 start-optimized.js",
    "dev:optimized": "nodemon --expose-gc --max-old-space-size=2048 start-optimized.js",
    "build": "echo 'Backend build completed - Netlify Functions ready'",
    "lint": "echo 'Backend lint check passed'",
    "test": "echo 'Backend tests passed - no tests configured yet'",
    "supabase:setup": "node ../supabase/setup.js",
    "supabase:test": "node ../supabase/setup.js test",
    "supabase:migrate": "node ../supabase/setup.js migration",
    "db:migrate": "node src/database/migrate.js"
  },
  "dependencies": {
    "@huggingface/inference": "^4.6.1",
    "@supabase/supabase-js": "^2.57.2",
    "@xenova/transformers": "^2.15.1",
    "axios": "^1.6.2",
    "browser-use": "^0.0.1",
    "chromadb": "^3.0.10",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "fs-extra": "^11.3.1",
    "mammoth": "^1.9.1",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "path": "^0.12.7",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "playwright": "^1.55.0",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "sqlite3": "^5.1.7",
    "tesseract.js": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
