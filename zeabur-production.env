# 核心容器环境配置
DISABLE_DBUS=1
DISABLE_DEV_SHM_USAGE=1
NO_SANDBOX=1
DISABLE_GPU=1
ENABLE_LOG_FILTER=1
NODE_ENV=production
BROWSER_HEADLESS=true

# 强化X11和显示服务器禁用（修复Missing X server错误）
DISPLAY=""
XAUTHORITY=""
XDG_SESSION_TYPE=""
WAYLAND_DISPLAY=""

# 强化D-Bus系统总线禁用（修复socket错误）
DBUS_SESSION_BUS_ADDRESS=""
DBUS_SYSTEM_BUS_ADDRESS=""
NO_DBUS=1
DISABLE_SYSTEM_DBUS=1
DBUS_FATAL_WARNINGS=0
NO_AT_BRIDGE=1

# 容器环境基础配置
HOME="/tmp"
TMPDIR="/tmp"
USER="nobody"
LANG="C"
LC_ALL="C"
PATH="/usr/local/bin:/usr/bin:/bin"

# 禁用系统服务和集成
QT_ACCESSIBILITY=0
GNOME_ACCESSIBILITY=0
AT_SPI_BUS_ADDRESS=""
SESSION_MANAGER=""
PULSE_SERVER=""
SDL_AUDIODRIVER="dummy"
FONTCONFIG_PATH="/dev/null"
GTK_IM_MODULE=""
QT_IM_MODULE=""
XMODIFIERS=""

# VNC服务配置
VNC_SERVER_URL=https://recruitment-automation-vnc.zeabur.app
VNC_DISPLAY=:1
VNC_PORT=5901
VNC_PASSWORD=vnc123